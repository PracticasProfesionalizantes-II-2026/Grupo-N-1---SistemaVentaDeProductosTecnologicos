<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- Los uploads se sirven localmente, pero se almacenan fuera del paquete en Azure. -->
    <Content Update="wwwroot/uploads/**" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <Compile Include="../Observabilidad/Instrumentacion/*.cs" Link="Observabilidad/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
