@model Frontend.Models.ViewModels.Home.InicioCategoriaViewModel
<a class="inicio-categoria" asp-controller="Productos" asp-action="Index" asp-route-idCategoria="@Model.IdCategoria" data-categoria-id="@Model.IdCategoria">
    <div class="inicio-categoria__imagen">
        @if (Model.ImagenUrl is not null)
        {
            <img src="@Url.Content(Model.ImagenUrl)" alt="" loading="lazy" width="688" height="384" />
        }
        else
        {
            <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><rect x="9" y="12" width="46" height="32" rx="5" /><path d="M23 53h18M32 44v9M18 23h28M18 31h18" /></svg>
        }
    </div>
    <div class="inicio-categoria__contenido">
        <h3>@Model.Nombre</h3>
        <span>Ver productos <span aria-hidden="true">→</span></span>
    </div>
</a>
