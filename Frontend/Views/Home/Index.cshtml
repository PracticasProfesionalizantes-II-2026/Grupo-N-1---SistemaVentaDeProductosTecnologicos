@{
    ViewData["Title"] = "Inicio";
    var portada = Model.Destacados.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.ImagenUrl));
}
@model Frontend.Models.ViewModels.Home.InicioViewModel
<link rel="stylesheet" href="~/css/pages/inicio.css" asp-append-version="true" />
<div class="inicio">
    <section class="inicio__hero container" aria-labelledby="inicio-titulo">
        <div class="inicio__hero-texto">
            <p class="inicio__eyebrow">TOTALTECH · TECNOLOGÍA A TU ALCANCE</p>
            <h1 id="inicio-titulo">Tecnología para tu próximo proyecto</h1>
            <p>Encontrá equipos y accesorios para trabajar, estudiar y jugar. Explorá nuestra selección y elegí lo que va con vos.</p>
            <a href="#productos-inicio" class="btn inicio__hero-boton">Explorar productos <span aria-hidden="true">→</span></a>
        </div>
        <div class="inicio__hero-imagen">
            @if (portada is not null)
            {
                <img src="@portada.ImagenUrl" alt="@portada.Nombre" width="440" height="330" />
                <span>@portada.Nombre</span>
            }
            else
            {
                <img src="~/images/totaltech-logo.png" alt="TotalTech" width="440" height="330" />
            }
        </div>
    </section>
    <div class="container inicio__contenido">
        @if (TempData["AuthSuccess"] is string mensaje)
        {
            <div class="alert alert-success" role="status">@mensaje</div>
        }
        <section class="inicio__categorias" aria-labelledby="inicio-categorias">
            <div class="inicio__encabezado"><div><h2 id="inicio-categorias">Explorá por categoría</h2><p>Encontrá lo que buscás para tu próximo proyecto.</p></div></div>
            @if (Model.ErrorCategorias is not null)
            {
                <div class="inicio__vacio" role="alert"><p>@Model.ErrorCategorias</p><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Reintentar</a></div>
            }
            else if (Model.Categorias.Count == 0)
            {
                <div class="inicio__vacio" role="status">Todavía no hay categorías disponibles.</div>
            }
            else
            {
                <div class="inicio__grilla-categorias" data-inicio-categorias>
                    @foreach (var categoria in Model.Categorias)
                    {
                        <partial name="_InicioCategoria" model="categoria" />
                    }
                </div>
            }
        </section>
        @if (Model.Destacados.Count > 0)
        {
            <section class="inicio__destacados" aria-labelledby="inicio-destacados">
                <div class="inicio__encabezado">
                    <div><p class="inicio__eyebrow">SELECCIÓN DE DEMOSTRACIÓN</p><h2 id="inicio-destacados">Nuestros destacados</h2></div>
                    <a href="#productos-inicio" class="btn btn-outline-primary">Ver todos <span aria-hidden="true">→</span></a>
                </div>
                <div class="inicio__grilla inicio__grilla--destacados">
                    @foreach (var producto in Model.Destacados)
                    {
                        <partial name="_InicioProducto" model="producto" />
                    }
                </div>
            </section>
        }
        <section id="productos-inicio" class="inicio__catalogo" aria-labelledby="inicio-productos">
            <div class="inicio__encabezado">
                <div><h2 id="inicio-productos">Todos nuestros productos</h2>
                    @if (Model.Error is null) { <p>@Model.Productos.Count producto(s) para explorar</p> }
                </div>
                <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary">Ir al catálogo con filtros <span aria-hidden="true">→</span></a>
            </div>
            @if (Model.Error is not null)
            {
                <div class="inicio__vacio" role="alert"><p>@Model.Error</p><a asp-action="Index" class="btn btn-primary">Reintentar</a></div>
            }
            else if (Model.Productos.Count == 0)
            {
                <div class="inicio__vacio" role="status"><h3>Pronto vas a encontrar más tecnología acá</h3><p>Todavía no hay productos disponibles para mostrar. Volvé a visitarnos.</p></div>
            }
            else
            {
                <div class="inicio__grilla" data-inicio-productos>
                    @foreach (var producto in Model.Productos)
                    {
                        <partial name="_InicioProducto" model="producto" />
                    }
                </div>
            }
        </section>
    </div>
</div>
