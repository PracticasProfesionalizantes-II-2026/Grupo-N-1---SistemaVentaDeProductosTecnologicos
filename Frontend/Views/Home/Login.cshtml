@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["IsLoginPage"] = true;
}

<section class="shipping-banner" aria-label="Promoción de envío gratis">
    <span>Envío</span>
    <svg class="shipping-illustration" aria-hidden="true" viewBox="0 0 240 160">
        <path class="shipping-box" d="M54 53 120 23l66 30-66 31-66-31Zm0 0v62l66 31 66-31V53m-66 31v62" />
        <path class="shipping-mark" d="m91 102 19 10 40-35" />
        <path class="shipping-line" d="M23 75h36M13 94h44M27 113h32" />
    </svg>
    <span class="shipping-outline">Gratis</span>
</section>

<section class="login-section" aria-labelledby="login-title">
    <h1 id="login-title">Inicio de sesión</h1>

    <div class="login-avatar" aria-hidden="true">
        <svg viewBox="0 0 120 120">
            <circle cx="60" cy="44" r="22" />
            <path d="M18 112c3-27 19-43 42-43s39 16 42 43" />
        </svg>
    </div>

    @if (TempData["AuthSuccess"] is string successMessage)
    {
        <div class="auth-alert auth-alert-success" role="status">@successMessage</div>
    }

    <form class="login-form" asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert-error" role="alert"></div>

        <div class="login-field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" placeholder="Email" autocomplete="username" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <div class="login-field">
            <label asp-for="Contrasena"></label>
            <input asp-for="Contrasena" type="password" placeholder="Contraseña" autocomplete="current-password" />
            <span asp-validation-for="Contrasena" class="field-validation-error"></span>
        </div>

        <a class="forgot-password" asp-area="" asp-controller="Home" asp-action="Privacy">¿Olvidaste tu contraseña?</a>
        <button class="login-submit" type="submit">Ingresar</button>
        <p class="auth-switch">¿Todavía no tenés una cuenta? <a asp-action="Register">Registrate gratis</a></p>
    </form>
</section>

<a class="whatsapp-link" href="#" aria-label="Contactar por WhatsApp">
    <svg aria-hidden="true" viewBox="0 0 48 48">
        <path d="M39 8.8A20.3 20.3 0 0 0 7.1 33.2L4 44l11.1-2.9A20.2 20.2 0 0 0 24.8 44h.1A20.4 20.4 0 0 0 39 8.8Z" />
        <path class="whatsapp-phone" d="M17 14.5c-.5-1.2-1-1.2-1.5-1.2h-1.2c-.4 0-1 .2-1.5.8-.5.6-2 2-2 4.8s2.1 5.6 2.4 6c.3.4 4 6.4 10 8.7 8.2 3.2 9.9 2.6 11.7 2.4 1.8-.2 5.7-2.3 6.5-4.6.8-2.2.8-4.1.6-4.5-.3-.4-.9-.6-1.8-1.1l-5.2-2.5c-.8-.3-1.4-.5-2 .4-.6.9-2.3 2.8-2.8 3.4-.5.6-1 .7-1.9.3a21.5 21.5 0 0 1-6.1-3.8 22.8 22.8 0 0 1-4.2-5.2c-.4-.8 0-1.3.4-1.8.4-.4.9-1 1.3-1.5.4-.5.5-.9.8-1.5.2-.6.1-1.1-.1-1.5L17 14.5Z" />
    </svg>
</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
