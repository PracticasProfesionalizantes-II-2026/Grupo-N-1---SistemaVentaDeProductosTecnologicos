@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["IsLoginPage"] = true;
}

<section class="login-section" aria-labelledby="login-title">
    <div class="login-card">
        <header class="login-heading">
            <div class="login-avatar" aria-hidden="true">
                <svg viewBox="0 0 120 120">
                    <circle cx="60" cy="44" r="22" />
                    <path d="M18 112c3-27 19-43 42-43s39 16 42 43" />
                </svg>
            </div>
            <p class="login-eyebrow">TotalTech</p>
            <h1 id="login-title">Iniciar sesión</h1>
            <p class="login-intro">Accedé a tu cuenta para continuar.</p>
        </header>

        @if (TempData["AuthSuccess"] is string successMessage)
        {
            <div class="auth-alert auth-alert-success" role="status">@successMessage</div>
        }

        <form class="login-form" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert-error" role="alert"></div>

            <div class="login-field">
                <label asp-for="Email"></label>
                <input asp-for="Email"
                       type="email"
                       placeholder="nombre@ejemplo.com"
                       autocomplete="username"
                       inputmode="email"
                       autocapitalize="none"
                       spellcheck="false" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="login-field">
                <label asp-for="Contrasena"></label>
                <input asp-for="Contrasena"
                       type="password"
                       placeholder="Ingresá tu contraseña"
                       autocomplete="current-password" />
                <span asp-validation-for="Contrasena"></span>
            </div>

            <button class="login-submit" type="submit">Iniciar sesión</button>
            <p class="auth-switch">¿Todavía no tenés una cuenta? <a asp-action="Register">Registrate gratis</a></p>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
