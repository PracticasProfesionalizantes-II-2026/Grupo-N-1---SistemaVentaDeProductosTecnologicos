@model Frontend.Models.ViewModels.Productos.ProductoDetalleViewModel
@{ ViewData["Title"] = Model.Nombre; var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}"; }
<div class="container py-4 producto-detalle admin-module">
    <a asp-action="Index" class="btn btn-link admin-module__back">← Volver al catálogo</a>
    @if (TempData["Error"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
    <article class="producto-detalle__contenido admin-panel admin-detail-card">
        @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl)) { <img src="@Model.ImagenUrl" class="product-detail-image" alt="@Model.Nombre" /> }
        else { <div class="product-image-placeholder product-detail-image" role="img" aria-label="@Model.Nombre: imagen no disponible">Sin imagen disponible</div> }
        <div>
            <p class="@(User.IsInRole("Admin") ? "admin-module__eyebrow" : "text-muted")">@Model.CategoriaNombre</p>
            <h1>@Model.Nombre</h1><p>@Model.Descripcion</p><p class="h3">$ @Model.Precio.ToString("N2")</p>
            <p class="@(Model.Stock > 0 ? "text-success" : "text-danger")"><strong>@(Model.Stock > 0 ? $"Disponible ({Model.Stock})" : "Sin stock")</strong></p>
            @if (Model.Stock > 0 && User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Carrito" asp-action="Agregar" method="post">
                    @Html.AntiForgeryToken()<input type="hidden" name="idProducto" value="@Model.IdProducto" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button class="btn btn-primary" type="submit">Agregar al carrito</button>
                </form>
            }
            else if (Model.Stock > 0)
            { <a asp-controller="Home" asp-action="Login" asp-route-returnUrl="@returnUrl" class="btn btn-primary">Iniciá sesión para agregar al carrito</a> }
            else { <button class="btn btn-secondary" disabled>Sin stock</button> }
        </div>
    </article>
</div>
