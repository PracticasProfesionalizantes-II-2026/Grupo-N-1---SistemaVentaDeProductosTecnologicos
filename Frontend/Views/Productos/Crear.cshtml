@* ============================================================================ *@
@* MÓDULO: PRODUCTOS                                                          *@
@* RESPONSABILIDAD: Recibir los datos para crear un producto.                  *@
@* ============================================================================ *@
@model Frontend.Models.Api.Requests.ProductoRequest
<div class="container py-4"><h1>Nuevo producto</h1><form asp-action="Crear" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Nombre"></label><input asp-for="Nombre" class="form-control"/><label asp-for="Descripcion"></label><input asp-for="Descripcion" class="form-control"/><label asp-for="Precio"></label><input asp-for="Precio" type="number" step="0.01" min="0" class="form-control"/><label asp-for="Stock"></label><input asp-for="Stock" type="number" min="0" class="form-control"/><label asp-for="IdCategoria">Categoría</label><select asp-for="IdCategoria" asp-items="@(new SelectList(ViewBag.Categorias, "IdCategoria", "Nombre"))" class="form-select"><option value="">Seleccioná una categoría</option></select><span asp-validation-for="IdCategoria" class="text-danger"></span><label asp-for="IdProveedor"></label><input asp-for="IdProveedor" type="number" min="1" class="form-control"/><button class="btn btn-success mt-3">Guardar</button></form></div>
