@model Frontend.Models.ViewModels.Productos.CatalogoViewModel

@{
    ViewData["Title"] = "Productos";
    var titulo = ViewData["TituloProductos"]?.ToString() ?? "Productos";
    var nombresCategorias = Model.Categorias.ToDictionary(
        categoria => categoria.IdCategoria,
        categoria => categoria.Nombre);
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@titulo</h1>

        <div>
            @if (User.IsInRole("Admin")) { <a asp-controller="Productos" asp-action="Crear" class="btn btn-success">Nuevo producto</a> }
            <a asp-controller="Productos" asp-action="Index" class="btn btn-secondary">Ver todos</a>
        </div>
    </div>

    <!-- Buscar productos -->
    <form asp-controller="Productos"
          asp-action="Buscar"
          method="get"
          class="mb-3">

        <div class="input-group">

            <input type="text"
                   name="texto"
                   class="form-control"
                   placeholder="Buscar por nombre o descripción" />

            <button type="submit"
                    class="btn btn-primary">
                Buscar
            </button>

        </div>

    </form>

    <!-- Filtrar por categoría -->
    <form asp-controller="Productos"
          asp-action="Categoria"
          method="get"
          class="mb-3">

        <div class="input-group">

            <select name="id"
                    class="form-select"
                    aria-label="Categoría">
                <option value="">Seleccioná una categoría</option>
                @foreach (var categoria in Model.Categorias)
                {
                    if (categoria.IdCategoria == Model.CategoriaSeleccionadaId)
                    {
                        <option value="@categoria.IdCategoria" selected>@categoria.Nombre</option>
                    }
                    else
                    {
                        <option value="@categoria.IdCategoria">@categoria.Nombre</option>
                    }
                }
            </select>

            <button type="submit"
                    class="btn btn-outline-primary">
                Filtrar por categoría
            </button>

        </div>

    </form>

    <!-- Productos disponibles -->
    <div class="mb-4">

        <a asp-controller="Productos"
           asp-action="Disponibles"
           class="btn btn-success">
            Ver productos disponibles
        </a>

    </div>

    @if (Model.Productos.Count == 0)
    {
        <div class="alert alert-info">
            No se encontraron productos.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var producto in Model.Productos)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100">

                        <div class="card-body">

                            <h5 class="card-title">
                                @producto.Nombre
                            </h5>

                            <p class="card-text">
                                @producto.Descripcion
                            </p>

                            <p>
                                <strong>Precio:</strong>
                                $ @producto.Precio.ToString("N2")
                            </p>

                            <p>
                                <strong>Stock:</strong>
                                @producto.Stock
                            </p>

                            <p>
                                <strong>Categoría:</strong>
                                @(nombresCategorias.GetValueOrDefault(producto.IdCategoria)
                                    ?? $"ID {producto.IdCategoria}")
                            </p>

                            <p>
                                <strong>Proveedor:</strong>
                                @producto.IdProveedor
                            </p>

                            <a asp-controller="Productos"
                               asp-action="Detalle"
                               asp-route-id="@producto.IdProducto"
                               class="btn btn-primary">
                                Ver producto
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Productos" asp-action="Editar" asp-route-id="@producto.IdProducto" class="btn btn-warning">Editar</a>
                                <form asp-controller="Productos" asp-action="Eliminar" asp-route-id="@producto.IdProducto" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('¿Seguro que deseas eliminar este producto?');">Eliminar</button>
                                </form>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
