@* ============================================================================ *@
@* MÓDULO: PRODUCTOS                                                          *@
@* RESPONSABILIDAD: Recibir los datos para editar un producto.                *@
@* ============================================================================ *@
@model Frontend.Models.Api.Requests.ProductoRequest
<div class="container py-4"><h1>Editar producto</h1><form asp-action="Editar" asp-route-id="@Context.Request.RouteValues["id"]" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Nombre"></label><input asp-for="Nombre" class="form-control"/><label asp-for="Descripcion"></label><input asp-for="Descripcion" class="form-control"/><label asp-for="Precio"></label><input asp-for="Precio" type="number" step="0.01" min="0" class="form-control"/><label asp-for="Stock"></label><input asp-for="Stock" type="number" min="0" class="form-control"/><label asp-for="IdCategoria"></label><input asp-for="IdCategoria" type="number" min="1" class="form-control"/><label asp-for="IdProveedor"></label><input asp-for="IdProveedor" type="number" min="1" class="form-control"/><button class="btn btn-warning mt-3">Guardar cambios</button></form></div>
