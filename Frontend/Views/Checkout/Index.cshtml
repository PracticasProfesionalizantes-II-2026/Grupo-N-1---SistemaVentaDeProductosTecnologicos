@model Frontend.Models.ViewModels.Checkout.CheckoutViewModel
@using System.Text.Json
@{ ViewData["Title"] = "Compra de demostración"; }
<link rel="stylesheet" href="~/css/pages/checkout.css" asp-append-version="true" />
<section class="compra-demo container" data-demo-page="checkout" data-user-id="@Model.IdUsuario"
         data-confirmacion-url="@Url.Action("Confirmacion", "Checkout")">
    <partial name="_CompraDemoAviso" />
    <h1>Simulá tu compra</h1>
    <p class="compra-demo__intro">Probá el recorrido completo con tus productos y un pago de demostración.</p>
    <ol class="compra-demo__pasos" aria-label="Pasos de la compra">
        <li aria-current="step">1. Resumen</li><li>2. Pago simulado</li><li>3. Confirmación</li>
    </ol>
    @if (Model.Error is not null)
    {
        <div class="alert alert-warning" role="alert">@Model.Error</div>
        <a asp-action="Index" class="btn btn-primary">Reintentar carga</a>
    }
    else if (!Model.PuedeSimular)
    {
        <div class="compra-demo__panel"><h2>Tu carrito está vacío</h2><p>Agregá productos para iniciar una compra ficticia.</p>
            <a asp-controller="Productos" asp-action="Index" class="btn btn-primary">Explorar productos</a>
        </div>
    }
    else
    {
        <div class="compra-demo__grilla">
            <section class="compra-demo__panel" aria-label="Resumen del carrito">
                <h2>Tu compra demo</h2>
                <div data-demo-resumen>
                    @foreach (var item in Model.Carrito!.Items)
                    {
                        <div class="compra-demo__linea"><strong>@item.Nombre</strong><span>@item.Cantidad × $ @item.PrecioUnitario.ToString("N2")</span><span>$ @item.Subtotal.ToString("N2")</span></div>
                    }
                    <p class="compra-demo__total">Total: $ @Model.Carrito.Total.ToString("N2")</p>
                </div>
                <p>Envío gratuito demo · $ 0</p>
                <hr />
                <h3>Dirección ficticia</h3>
                <p>Avenida Demo 123, Ciudad de demostración, Argentina.</p>
            </section>
            <section class="compra-demo__panel">
                <h2>Pago de demostración</h2>
                <div class="compra-demo__tarjeta" aria-label="Tarjeta ficticia terminada en 4242">
                    <span>Tarjeta demo</span><strong>•••• &nbsp; •••• &nbsp; •••• &nbsp; 4242</strong><span>Datos ficticios · Sin cobros</span>
                </div>
                <form data-demo-form>
                    <label for="demo-escenario">Resultado de la simulación</label>
                    <select id="demo-escenario" class="form-select" name="escenario">
                        <option value="aprobacion">Aprobación · 2 segundos</option>
                        <option value="rechazo">Rechazo · 2 segundos</option>
                        <option value="demora">Demora · 6 segundos</option>
                    </select>
                    <button type="submit" class="btn btn-primary compra-demo__comprar" disabled>Simular pago</button>
                </form>
                <div class="compra-demo__procesamiento" data-demo-loading hidden aria-hidden="true">
                    <span class="compra-demo__spinner"></span><span>Procesando pago ficticio…</span>
                </div>
                <p data-demo-feedback role="status" aria-live="polite" tabindex="-1"></p>
            </section>
        </div>
        <script id="demo-carrito" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Carrito, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
    }
    <noscript><p class="alert alert-warning">Activá JavaScript para usar la simulación. Tu carrito sigue disponible.</p></noscript>
    <div class="compra-demo__acciones"><a asp-controller="Carrito" asp-action="Index" class="btn btn-outline-secondary">Volver al carrito</a><a asp-controller="Pedidos" asp-action="Index">Mis pedidos demo</a></div>
</section>
@section Scripts {
    <script type="module" src="~/js/pages/checkout.js" asp-append-version="true"></script>
}
