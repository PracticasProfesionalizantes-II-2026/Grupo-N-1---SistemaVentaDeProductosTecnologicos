@if (User.Identity?.IsAuthenticated == true && ViewData["IsLoginPage"] is not true && TempData["AuthWelcome"] is string bienvenida)
{
    @if (ViewData["AuthWelcomeCompact"] is true)
    {
        <span class="header-welcome" role="status" title="@bienvenida" data-auth-welcome>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 21v-2a7 7 0 0 0-14 0v2M17 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" /></svg>
            <span class="header-welcome__text">@bienvenida</span>
        </span>
    }
    else
    {
        <div class="alert alert-success m-3" role="status" data-auth-welcome>@bienvenida</div>
    }
}
