<!DOCTYPE html>

@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var isLoginPage = ViewData["IsLoginPage"] as bool? ?? false;
    var isRegisterPage = ViewData["IsRegisterPage"] as bool? ?? false;
}

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - TotalTech
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Frontend.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />

</head>

<body class="storefront @(isLoginPage ? "login-body" : null)">

    <header class="site-header">

        <div class="header-topbar">

            <a class="header-brand"
               asp-controller="Home"
               asp-action="Index"
               aria-label="Ir al inicio de TotalTech">

                <img src="~/images/totaltech-logo.png"
                     alt="TotalTech" />

            </a>

            <form asp-controller="Productos"
                  asp-action="Buscar"
                  method="get"
                  class="header-search"
                  role="search">

                <svg aria-hidden="true"
                     viewBox="0 0 24 24">

                    <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />

                </svg>

                <input type="search"
                       name="texto"
                       placeholder="Buscar productos"
                       aria-label="Buscar productos" />

                <button type="submit"
                        aria-label="Buscar">

                    Buscar

                </button>

            </form>

            @if (!isLoginPage)
            {
                <div class="header-actions @(User.Identity?.IsAuthenticated == true ? "header-actions--authenticated" : null)">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @await Component.InvokeAsync("CarritoBadge")
                        <form asp-controller="Home" asp-action="Logout" method="post" class="header-logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" aria-label="Cerrar sesión" title="Cerrar sesión"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H5v16h4M14 8l4 4-4 4M9 12h9" /></svg><span>Cerrar sesión</span></button>
                        </form>
                    }
                    else
                    {
                        <a class="cart-link" asp-controller="Home" asp-action="Login" asp-route-returnUrl="/Carrito" aria-label="Iniciar sesión para ver el carrito">
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 1.9-1.4L21 7H6m4 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm9 0a1 1 0 1 1-2 0 1 1-2 0Z" /></svg><span class="cart-link__text">Carrito</span>
                        </a>
                    }
                </div>
            }

            @if (isLoginPage)
            {
                <div class="header-actions">

                    <a class="register-link"
                       asp-controller="Home"
                       asp-action="@(isRegisterPage ? "Login" : "Register")">

                        @(isRegisterPage ? "Iniciar sesión" : "Registrarse")

                    </a>

                    <a class="cart-link"
                       asp-controller="Home"
                       asp-action="Index"
                       aria-label="Volver al inicio">

                        <svg aria-hidden="true"
                             viewBox="0 0 24 24">

                            <path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 1.9-1.4L21 7H6m4 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm9 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" />

                        </svg>

                    </a>

                </div>
            }

        </div>

        <nav class="main-navigation"
             aria-label="Navegación principal">

            <a asp-controller="Home"
               asp-action="Index">
                Inicio
            </a>

            <a asp-controller="Productos"
               asp-action="Index">
                Productos
            </a>

            <a asp-controller="Consultas"
               asp-action="Garantia">
                Garantía
            </a>

            @if (isLoginPage)
            {
                <a asp-controller="Home"
                   asp-action="Index">
                    Servicios
                </a>
            }

            <a asp-controller="Consultas"
               asp-action="Contacto">
                Contactos
            </a>

            @if (!isLoginPage && User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Home" asp-action="Login" class="navigation-login">Iniciar sesión</a>
            }
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin")) { <a asp-controller="Administracion" asp-action="Index">Administración</a> }
            @if (User.Identity?.IsAuthenticated == true && Configuration.GetValue<bool>("CompraDemo:Enabled"))
            {
                <a asp-controller="Pedidos" asp-action="Index">Mis pedidos demo</a>
            }

        </nav>

    </header>

    <main role="main"
          class="site-main">

        <partial name="_AuthWelcome" />
        @RenderBody()

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
