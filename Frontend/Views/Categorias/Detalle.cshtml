@* ============================================================================ *@
@* MÓDULO: CATEGORÍAS                                                         *@
@* RESPONSABILIDAD: Mostrar el detalle de una categoría.                       *@
@* ============================================================================ *@
@model Frontend.Models.Api.Responses.CategoriaResponse

@{
    ViewData["Title"] = "Detalle de la categoría";
}

<div class="container py-4">

    <h1 class="mb-4">Detalle de la categoría</h1>

    <div class="card">

        <div class="card-body">

            <h2 class="card-title mb-3">
                @Model.Nombre
            </h2>

            <p>
                <strong>ID:</strong>
                @Model.IdCategoria
            </p>

            <p>
                <strong>Descripción:</strong>
                @Model.Descripcion
            </p>

            <p>
                <strong>Precio:</strong>
                @Model.Descripcion
            </p>

            <p>
            </p>

        </div>

    </div>

    <div class="mt-4">

        <a asp-controller="Productos"
           asp-action="Index"
           class="btn btn-secondary">
            Volver a productos
        </a>

    </div>

</div>
