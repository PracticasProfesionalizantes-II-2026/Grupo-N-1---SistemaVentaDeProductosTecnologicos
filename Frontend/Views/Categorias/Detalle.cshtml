@* ============================================================================ *@
@* MÓDULO: CATEGORÍAS                                                         *@
@* RESPONSABILIDAD: Mostrar el detalle de una categoría.                       *@
@* ============================================================================ *@
@model Frontend.Models.Api.Responses.CategoriaResponse

@{
    ViewData["Title"] = "Detalle de la categoría";
}

<div class="container py-4 admin-module">

    <div class="admin-module__header mb-4"><div>@if (User.IsInRole("Admin")) { <p class="admin-module__eyebrow">Categorías</p> }<h1>Detalle de la categoría</h1></div></div>

    <div class="card admin-panel admin-detail-card admin-detail-card--stacked">

        <div class="card-body">

            <h2 class="card-title mb-3">
                @Model.Nombre
            </h2>

            <p>
                <strong>ID:</strong>
                @Model.IdCategoria
            </p>

            <p>
                <strong>Descripción:</strong>
                @Model.Descripcion
            </p>

            <p>
                <strong>Precio:</strong>
                @Model.Descripcion
            </p>

            <p>
            </p>

        </div>

    </div>

    <div class="mt-4">

        <a asp-controller="Productos"
           asp-action="Index"
           class="btn btn-secondary">
            Volver a productos
        </a>

    </div>

</div>
