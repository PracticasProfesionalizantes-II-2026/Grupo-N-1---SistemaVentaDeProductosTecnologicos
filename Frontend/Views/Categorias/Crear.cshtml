@model Frontend.Models.Api.Requests.CategoriaRequest

@{
    ViewData["Title"] = "Crear categoría";
}

<div class="container py-4 admin-module">

    <div class="admin-module__header"><div><p class="admin-module__eyebrow">Categorías</p><h1>Nueva categoría</h1><p>Creá una clasificación para organizar el catálogo.</p></div></div>

    <form asp-controller="Categorias"
          asp-action="Crear"
          method="post"
          class="admin-form admin-panel">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="mb-3">

            <label asp-for="Nombre"
                   class="form-label">
                Nombre
            </label>

            <input asp-for="Nombre"
                   class="form-control"
                   placeholder="Ejemplo: Notebooks" />

        </div>

        <div class="mb-3">

            <label asp-for="Descripcion"
                   class="form-label">
                Descripción
            </label>

            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="4"
                      placeholder="Descripción de la categoría">
            </textarea>

        </div>

        <button type="submit"
                class="btn btn-primary">
            Guardar
        </button>

        <a asp-controller="Categorias"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>
